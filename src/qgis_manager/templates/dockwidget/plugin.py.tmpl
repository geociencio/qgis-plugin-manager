"""
Main plugin class for {{ name }}.
"""

import os

from qgis.PyQt.QtCore import QCoreApplication, QTranslator
from qgis.PyQt.QtGui import QIcon
from qgis.PyQt.QtWidgets import QAction

from .{{ slug }}_dockwidget import {{ class_name }}DockWidget


class {{ class_name }}:
    """QGIS Plugin Implementation."""

    def __init__(self, iface):
        """Initialize the plugin."""
        self.iface = iface
        self.dockwidget = None
        self.action = None

    def initGui(self):
        """Initialize the GUI."""
        icon_path = os.path.join(os.path.dirname(__file__), "icon.png")
        self.action = QAction(QIcon(icon_path), "{{ name }}", self.iface.mainWindow())
        self.action.triggered.connect(self.run)
        self.iface.addToolBarIcon(self.action)
        self.iface.addPluginToMenu("{{ name }}", self.action)

    def onClosePlugin(self):
        self.dockwidget.closingPlugin.disconnect(self.onClosePlugin)
        self.dockwidget = None

    def unload(self):
        """Unload the plugin."""
        if self.dockwidget:
            self.dockwidget.close()
            self.dockwidget = None
        self.iface.removePluginMenu("{{ name }}", self.action)
        self.iface.removeToolBarIcon(self.action)

    def run(self):
        if self.dockwidget is None:
            self.dockwidget = {{ class_name }}DockWidget()
            self.iface.addDockWidget(
                self.iface.rightDockWidgetArea(), self.dockwidget
            )
            self.dockwidget.closingPlugin.connect(self.onClosePlugin)
        self.dockwidget.show()
